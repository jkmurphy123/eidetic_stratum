{
  "name": "alderwick-correspondent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "ingest:batch": "node scripts/ingest-batch.mjs",
    "draft:daily": "node scripts/draft-daily.mjs",
    "content:prepare": "node scripts/prepare-content.mjs",
    "dev": "npm run content:prepare && astro dev",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run content:prepare && astro build",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "astro": "7.3.5",
    "sharp": "0.35.4"
  }
}
