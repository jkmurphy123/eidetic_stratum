{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["edition_date", "run_id", "article_ids", "assets", "validation"],
  "properties": {
    "edition_date": {"type":"string", "pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "run_id": {"type":"string", "pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "article_ids": {"type":"array", "uniqueItems":true, "items":{"type":"string", "pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "assets": {"type":"array", "uniqueItems":true, "items":{"type":"string", "pattern":"^/images/articles/[0-9]{4}/[0-9]{2}/[0-9]{2}/[a-z0-9]+(?:-[a-z0-9]+)*\\.png$"}},
    "validation": {"type":"object", "additionalProperties":false, "required":["status","article_count"], "properties":{"status":{"const":"passed"},"article_count":{"type":"integer","minimum":0}}}
  }
}
