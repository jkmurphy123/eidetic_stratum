---
import FeedPage from '../../../../components/FeedPage.astro';
import archive from '../../../../generated/articles.json';
import {createArchive} from '../../../../lib/archive.mjs';
export function getStaticPaths() {
  const selectors=createArchive(archive.articles,archive.categories);
  return selectors.tags().flatMap(slug => selectors.tagPages(slug).slice(1).map(page => ({params:{slug,number:String(page.number)}})));
}
const {slug}=Astro.params;
const number=Number(Astro.params.number);
---
<FeedPage kind="tag" slug={slug} number={number} />
